<style>
:root {
    --bg: #08090c;
    --surface: #101218;
    --surface2: #151820;
    --border: rgba(255,255,255,.08);
    --text: #f4f5f7;
    --muted: #969ba7;
    --accent: #ffffff;
    --max: 1100px;
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    background:
        radial-gradient(circle at 50% -10%, rgba(255,255,255,.08), transparent 35%),
        var(--bg);
    color: var(--text);
    font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Arial,
        sans-serif;
    line-height: 1.75;
}

a {
    color: inherit;
    text-decoration: none;
}

.container {
    width: min(calc(100% - 40px), var(--max));
    margin: auto;
}

/* HEADER */

header {
    position: sticky;
    top: 0;
    z-index: 20;
    backdrop-filter: blur(18px);
    background: rgba(8,9,12,.78);
    border-bottom: 1px solid var(--border);
}

.nav {
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    letter-spacing: -.03em;
}

.logo-mark {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    background: white;
    color: black;
    font-size: 15px;
}

.nav-right {
    display: flex;
    align-items: center;
    gap: 10px;
}

.btn {
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    border-radius: 10px;
    padding: 9px 14px;
    cursor: pointer;
    font-size: 13px;
    transition: .2s;
}

.btn:hover {
    background: var(--surface2);
    border-color: rgba(255,255,255,.16);
}

/* HERO */

.hero {
    padding: 90px 0 65px;
    border-bottom: 1px solid var(--border);
}

.badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 11px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    background: rgba(255,255,255,.025);
    font-size: 12px;
    margin-bottom: 22px;
}

.badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: white;
}

h1 {
    margin: 0;
    max-width: 850px;
    font-size: clamp(38px, 6vw, 68px);
    line-height: 1.02;
    letter-spacing: -.055em;
}

.hero p {
    max-width: 720px;
    margin: 24px 0 0;
    color: var(--muted);
    font-size: 17px;
}

.meta {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
}

.meta span {
    border: 1px solid var(--border);
    padding: 7px 11px;
    border-radius: 8px;
    font-size: 12px;
    color: var(--muted);
}

/* LAYOUT */

.layout {
    display: grid;
    grid-template-columns: 250px 1fr;
    gap: 55px;
    padding: 55px 0 100px;
}

aside {
    position: sticky;
    top: 95px;
    height: max-content;
}

.toc-title {
    color: var(--muted);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .12em;
    margin-bottom: 13px;
}

.toc a {
    display: block;
    padding: 7px 10px;
    margin: 2px 0;
    border-radius: 7px;
    color: var(--muted);
    font-size: 13px;
    transition: .2s;
}

.toc a:hover {
    color: white;
    background: var(--surface);
}

/* DOCUMENT */

.document {
    min-width: 0;
}

.notice {
    padding: 18px 20px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: linear-gradient(
        135deg,
        rgba(255,255,255,.045),
        rgba(255,255,255,.015)
    );
    margin-bottom: 45px;
}

.notice strong {
    display: block;
    margin-bottom: 5px;
}

.notice p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
}

section {
    scroll-margin-top: 95px;
    margin-bottom: 58px;
}

h2 {
    font-size: 25px;
    letter-spacing: -.025em;
    margin: 0 0 18px;
}

h3 {
    font-size: 17px;
    margin: 28px 0 8px;
}

p {
    margin: 10px 0 16px;
}

ul,
ol {
    padding-left: 23px;
}

li {
    margin: 7px 0;
}

.muted {
    color: var(--muted);
}

.highlight {
    padding: 2px 6px;
    border-radius: 5px;
    background: rgba(255,255,255,.07);
}

.divider {
    height: 1px;
    background: var(--border);
    margin: 55px 0;
}

/* SELLER CARD */

.seller {
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: 16px;
    padding: 24px;
}

.seller-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
}

.seller-item {
    padding: 14px;
    border-radius: 10px;
    background: rgba(255,255,255,.025);
}

.seller-item small {
    display: block;
    color: var(--muted);
    font-size: 11px;
    margin-bottom: 4px;
}

.seller-item strong {
    font-size: 14px;
    word-break: break-word;
}

/* FOOTER */

footer {
    border-top: 1px solid var(--border);
    padding: 35px 0;
    color: var(--muted);
    font-size: 12px;
}

.footer-row {
    display: flex;
    justify-content: space-between;
    gap: 20px;
}

/* SEARCH */

.search {
    width: 170px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: white;
    outline: none;
    padding: 9px 12px;
    border-radius: 9px;
    font-size: 12px;
}

mark {
    background: white;
    color: black;
    border-radius: 3px;
    padding: 0 2px;
}

/* MOBILE */

@media (max-width: 800px) {

    .container {
        width: min(calc(100% - 28px), var(--max));
    }

    .hero {
        padding: 60px 0 45px;
    }

    .layout {
        display: block;
        padding-top: 35px;
    }

    aside {
        position: static;
        margin-bottom: 35px;
    }

    .toc {
        display: grid;
        grid-template-columns: 1fr 1fr;
    }

    .seller-grid {
        grid-template-columns: 1fr;
    }

    .nav-right .search {
        display: none;
    }

    .footer-row {
        flex-direction: column;
    }
}

@media print {

    header,
    aside,
    .btn,
    .search {
        display: none !important;
    }

    body {
        background: white;
        color: black;
    }

    .container {
        width: 100%;
    }

    .layout {
        display: block;
    }
}
</style>
